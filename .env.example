# Little Wins configuration. Copy this file to .env and fill it in:
#
#   cp .env.example .env && chmod 600 .env
#
# .env is git-ignored; never commit it. docker-compose.yml reads it with `env_file: .env`.
# Lines starting with # are comments. Values need no quotes. See docs/admin-guide.md.

# --- Where the app lives ----------------------------------------------------------------
# The public address people open, without a trailing path. Outside localhost it must start
# with https:// or the app refuses to start. It is also used to build invite and device links.
APP_BASE_URL=https://<your-domain>

# --- Sign-in state secret ---------------------------------------------------------------
# Signs the short-lived cookie that carries a sign-in in progress. At least 32 characters,
# not a placeholder. Required outside localhost. Generate one with:
#
#   openssl rand -hex 32
#
# Changing it only interrupts sign-ins in progress; nobody is logged out.
SESSION_SECRET=<paste the output of openssl rand -hex 32>

# --- Sign-in providers ------------------------------------------------------------------
# Set at least one provider, and for each one set both the ID and the secret (or neither).
# See "Register the sign-in apps" in docs/admin-guide.md.
#
# Callback URLs to register with each provider (use your own APP_BASE_URL):
#   Google: <APP_BASE_URL>/auth/google/callback
#   GitHub: <APP_BASE_URL>/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Who may create a family ------------------------------------------------------------
# SIGNUP_MODE decides who may create a new family:
#   closed  only people on PARENT_ALLOWLIST (default; right for one family at home)
#   invite  hosting by invitation: only people holding a family invite (made on the operator
#           page, single use, 30 days) or on PARENT_ALLOWLIST
#   open    anyone who signs in may create a family (hosted mode)
# Co-parents never need this: a parent invites them from Settings -> Parents.
SIGNUP_MODE=closed

# Comma-separated entries. Anyone matching an entry may create a family (or claim a migrated
# one) when SIGNUP_MODE is closed or invite. Entry syntax:
#   *                          anyone who signs in (only use this on localhost)
#   google:you@example.com     that Google account, matched on its verified email
#   github:<login>             that GitHub login
#   google-domain:example.com  any account in that Google Workspace domain
# Example: PARENT_ALLOWLIST=google:you@example.com,github:<login>
# An entry the app can't read stops it from starting.
PARENT_ALLOWLIST=google:you@example.com

# --- Storage and port -------------------------------------------------------------------
# SQLite file. docker-compose.yml already sets /data/little-wins.db (the mounted volume), so
# leave this commented out when using Docker. Outside Docker the default is the same path.
# DATABASE_PATH=/data/little-wins.db
# (DB is still read as a fallback if DATABASE_PATH is not set.)

# Port the app listens on inside the container or process. Default 3000. With Docker, change
# the published port in docker-compose.override.yml instead (or APP_PORT with deploy/nginx).
# PORT=3000

# Time zone of the container. Each family has its own time zone, so this only places data
# migrated from an old single-family install. Default UTC.
# TZ=UTC

# --- Behind a reverse proxy -------------------------------------------------------------
# Comma-separated proxy addresses whose X-Forwarded-For and X-Forwarded-Proto headers the app
# trusts (exact IPs, or * for any peer; * is only safe when the app's port is reachable by the
# proxy alone). Default empty: forwarded headers are ignored. Outside localhost the app
# redirects plain HTTP to APP_BASE_URL, so behind a proxy this must be set. See deploy/.
# FORWARDED_ALLOW_IPS=

# Host name Caddy serves (deploy/caddy only). The host part of APP_BASE_URL.
# SITE_HOST=<your-domain>

# --- Hosting for other families (optional) ----------------------------------------------
# Entries (same syntax as PARENT_ALLOWLIST) of who sees the operator page. Default empty.
# OPERATOR_ALLOWLIST=
# Links shown on the sign-in page and in Settings. Default empty (no links).
# PRIVACY_URL=
# TERMS_URL=

# Evening reminders, opt-in per parent device, through the phone's push service (Apple, Google,
# Mozilla). 0 turns them off. Default on.
# PUSH_REMINDERS=1
# A family no phone or browser has used for this many days is deleted, with all its data
# (at least 30; 0 turns it off). Default 365.
# DELETE_IDLE_FAMILIES_DAYS=365
# The most families this installation holds (any SIGNUP_MODE). Past it, new parents see "full
# for now"; co-parents can still join. Default: no cap.
# LIMIT_FAMILIES=50
# Whom a family without a place can ask: an https:// or mailto: address, shown as "Ask for a
# place" on the private and full screens. Default: none.
# SIGNUP_CONTACT_URL=mailto:you@example.com
# Emails to you, the operator (counts only): a family signed up, the last place taken, a parent
# turned away because it's full (once a day at most), a family deleted. Default: off.
# Set it to turn them on; comment it out (or remove it) and restart to turn them off. The SMTP_
# lines below are ignored while it is unset.
# NOTIFY_EMAIL=you@example.com
# Only some of them, comma-separated: signup, full, turned-away, deleted. Unset or empty means all
# four (to get none, unset NOTIFY_EMAIL instead).
# NOTIFY_EVENTS=full,turned-away
# The mail server that sends them (port 465 with TLS by default; 587 uses STARTTLS). For Gmail
# or Google Workspace: smtp.gmail.com and an app password (see the admin guide). At startup the
# log says "Mail server sign-in OK" or why not. To send a test email after a restart:
#   docker compose -f deploy/nginx/docker-compose.yml exec little-wins node server/mailer.js test
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@example.com
# SMTP_PASS=
# SMTP_FROM=you@example.com

# Per-family limits. Defaults when SIGNUP_MODE is closed: 20 / 10 / 500 / 200 / 50 / 2000.
# Defaults when SIGNUP_MODE is open or invite (hosted): 8 / 6 / 200 / 100 / 30 / 500.
# LIMIT_CHILDREN=20
# LIMIT_PARENTS=10
# LIMIT_ITEMS=500
# LIMIT_REWARDS=200
# LIMIT_DEVICES=50
# LIMIT_ENTRIES_PER_DAY=2000

# --- Demo families and the tour video (optional) ---------------------------------------
# 1 offers "Try a demo" on the sign-in page: a private made-up family per visitor, no sign-in,
# held in memory only. Off by default.
# DEMO_FAMILIES=1
# How many demo families at once (default 20), and how long one lasts unused (default 1800 s).
# DEMO_MAX=20
# DEMO_IDLE_SECONDS=1800
# 0 hides "Watch the video" (the 30-second tour at /tour.mp4) on the sign-in page.
# TOUR_VIDEO=0

# --- Development only -------------------------------------------------------------------
# Replaces Google and GitHub with a fake sign-in page served by the app. The app refuses to
# start with this set unless APP_BASE_URL is localhost. Never set it on a server.
# LITTLE_WINS_FAKE_SSO=1
