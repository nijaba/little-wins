# Little Wins configuration. Copy this file to .env and fill it in:
#
#   cp .env.example .env && chmod 600 .env
#
# .env is git-ignored; never commit it. docker-compose.yml reads it with `env_file: .env`.
# Lines starting with # are comments. Values need no quotes. See docs/admin-guide.md.

# --- Where the app lives ----------------------------------------------------------------
# The public address people open, without a trailing path. Outside localhost it must start
# with https:// or the app refuses to start. It is also used to build invite and device links.
APP_BASE_URL=https://<your-domain>

# --- Sign-in state secret ---------------------------------------------------------------
# Signs the short-lived cookie that carries a sign-in in progress. At least 32 characters,
# not a placeholder. Required outside localhost. Generate one with:
#
#   openssl rand -hex 32
#
# Changing it only interrupts sign-ins in progress; nobody is logged out.
SESSION_SECRET=<paste the output of openssl rand -hex 32>

# --- Sign-in providers ------------------------------------------------------------------
# Set at least one provider, and for each one set both the ID and the secret (or neither).
# See "Register the sign-in apps" in docs/admin-guide.md.
#
# Callback URLs to register with each provider (use your own APP_BASE_URL):
#   Google: <APP_BASE_URL>/auth/google/callback
#   GitHub: <APP_BASE_URL>/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Who may create a family ------------------------------------------------------------
# SIGNUP_MODE decides who may create a new family:
#   closed  only people on PARENT_ALLOWLIST (default; right for one family at home)
#   invite  meant for hosting: only people holding an invite from the operator. Operator-issued
#           invites do not exist yet, so for now this behaves exactly like closed.
#   open    anyone who signs in may create a family (hosted mode)
# Co-parents never need this: a parent invites them from Settings -> Parents.
SIGNUP_MODE=closed

# Comma-separated entries. Anyone matching an entry may create a family (or claim a migrated
# one) when SIGNUP_MODE is closed or invite. Entry syntax:
#   *                          anyone who signs in (only use this on localhost)
#   google:you@example.com     that Google account, matched on its verified email
#   github:<login>             that GitHub login
#   google-domain:example.com  any account in that Google Workspace domain
# Example: PARENT_ALLOWLIST=google:you@example.com,github:<login>
# An entry the app can't read stops it from starting.
PARENT_ALLOWLIST=google:you@example.com

# --- Storage and port -------------------------------------------------------------------
# SQLite file. docker-compose.yml already sets /data/little-wins.db (the mounted volume), so
# leave this commented out when using Docker. Outside Docker the default is the same path.
# DATABASE_PATH=/data/little-wins.db
# (DB is still read as a fallback if DATABASE_PATH is not set.)

# Port the app listens on inside the container or process. Default 3000. With Docker, change
# the published port in docker-compose.override.yml instead.
# PORT=3000

# Time zone of the container. Each family has its own time zone, so this only places data
# migrated from an old single-family install. Default UTC.
# TZ=UTC

# --- Development only -------------------------------------------------------------------
# Replaces Google and GitHub with a fake sign-in page served by the app. The app refuses to
# start with this set unless APP_BASE_URL is localhost. Never set it on a server.
# LITTLE_WINS_FAKE_SSO=1
