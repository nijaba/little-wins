{
  "name": "little-wins",
  "version": "0.1.0",
  "description": "A points, stars and rewards tracker for families, made for phones",
  "license": "Apache-2.0",
  "private": true,
  "type": "commonjs",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "LITTLE_WINS_FAKE_SSO=1 PARENT_ALLOWLIST='*' DATABASE_PATH=/tmp/little-wins-dev.db node server/index.js",
    "test": "node --test test/*.test.js",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test:coverage": "c8 --include 'server/**' --exclude 'server/fake-sso.js' --reporter=text --reporter=lcov --check-coverage --lines 95 --functions 95 --branches 90 node --test test/*.test.js",
    "test:e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium webkit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@playwright/test": "1.65.1",
    "c8": "12.0.0"
  }
}
